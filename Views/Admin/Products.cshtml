@model IEnumerable<RestaurantERP.Models.Product>
@{
    ViewBag.PageTitle = "إدارة المنتجات";
    var categories = ViewBag.Categories as List<RestaurantERP.Models.Category> ?? new();
    var branches = ViewBag.Branches as List<RestaurantERP.Models.Branch> ?? new();
    var selectedBranchId = ViewBag.BranchId as int?;
    var selectedBranch = branches.FirstOrDefault(b => b.Id == selectedBranchId);
    bool isReadOnly = User.IsInRole("محصل") && !User.IsInRole("Admin");
    int colSpan = 9 + branches.Count + (isReadOnly ? 0 : 1);
}

@* ── Branch filter bar ─────────────────────────────────────── *@
<div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap;
    padding:12px 16px;background:var(--card-bg);border:1px solid var(--border-color);
    border-radius:14px;box-shadow:var(--shadow)">
    <div style="font-size:12px;font-weight:700;color:var(--text-muted);white-space:nowrap">
        <i class="fas fa-code-branch me-1" style="color:var(--primary)"></i> فلتر الفرع:
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;flex:1">
        <a href="/Admin/Products"
           style="padding:5px 14px;border-radius:20px;font-size:12px;font-weight:700;
            text-decoration:none;
            border:2px solid @(selectedBranchId == null ? "var(--primary)" : "var(--border-color)");
            background:@(selectedBranchId == null ? "var(--primary)" : "transparent");
            color:@(selectedBranchId == null ? "#fff" : "var(--text-muted)")">
            🌐 كل الفروع
        </a>
        @foreach (var b in branches)
        {
            var isSel = selectedBranchId == b.Id;
            <a href="/Admin/Products?branchId=@b.Id"
               style="padding:5px 14px;border-radius:20px;font-size:12px;font-weight:700;
                text-decoration:none;display:flex;align-items:center;gap:4px;
                border:2px solid @(isSel ? b.ColorHex : "var(--border-color)");
                background:@(isSel ? b.ColorHex : "transparent");
                color:@(isSel ? "#fff" : "var(--text-muted)")">
                @b.Icon @b.NameAr
            </a>
        }
    </div>
    @if (selectedBranch != null)
    {
        <span style="font-size:11px;font-weight:700;padding:3px 10px;border-radius:12px;
            background:@(selectedBranch.ColorHex)18;color:@selectedBranch.ColorHex;
            border:1px solid @(selectedBranch.ColorHex)44">
            عرض: @selectedBranch.NameAr فقط
        </span>
    }
</div>

@* ── Header ────────────────────────────────────────────────── *@
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:12px">
    <div>
        <h2 style="font-size:20px;font-weight:800">المنتجات</h2>
        <p style="color:var(--text-secondary);font-size:12px">
            @Model.Count() منتج@(selectedBranch != null ? $" — {selectedBranch.NameAr}" : "")
        </p>
    </div>
    @if (!isReadOnly)
    {
        <a href="/Admin/CreateProduct@(selectedBranchId.HasValue ? "?branchId=" + selectedBranchId : "")" class="btn btn-accent">
            <span>➕</span> إضافة منتج
        </a>
    }
    else
    {
        <div style="padding:6px 14px;border-radius:20px;background:#0891b215;color:#0891b2;
            font-size:12px;font-weight:700;border:1px solid #0891b244">
            <i class="fas fa-eye me-1"></i> وضع القراءة فقط
        </div>
    }
</div>

@* ── Search filters ─────────────────────────────────────────── *@
<div class="card mb-4">
    <div class="card-body" style="padding:14px">
        <form method="get" style="display:flex;gap:10px;flex-wrap:wrap;align-items:end">
            <div style="flex:1;min-width:180px">
                <div class="search-bar">
                    <span class="search-icon">🔍</span>
                    <input type="text" name="search" value="@ViewBag.Search"
                           placeholder="بحث في المنتجات..." class="form-control">
                </div>
            </div>
            <select name="branchId" class="form-control" style="min-width:150px" onchange="this.form.submit()">
                <option value="">🌐 كل الفروع</option>
                @foreach (var b in branches)
                {
                    <option value="@b.Id" selected="@(selectedBranchId == b.Id)">@b.Icon @b.NameAr</option>
                }
            </select>
            <select name="categoryId" class="form-control" style="min-width:140px">
                <option value="">كل الفئات</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.Id" selected="@(ViewBag.CategoryId?.ToString() == cat.Id.ToString())">
                        @cat.Icon @cat.NameAr
                    </option>
                }
            </select>
            <select name="active" class="form-control" style="min-width:120px">
                <option value="">كل الحالات</option>
                <option value="true">نشط</option>
                <option value="false">غير نشط</option>
            </select>
            <button type="submit" class="btn btn-primary">🔍 بحث</button>
            <a href="/Admin/Products@(selectedBranchId.HasValue ? "?branchId=" + selectedBranchId : "")"
               class="btn btn-outline">إعادة تعيين</a>
        </form>
    </div>
</div>

@* ── Table ──────────────────────────────────────────────────── *@
<div class="card">
    <div class="table-wrapper" style="overflow-x:auto">
        <table class="data-table" id="productsTable" style="min-width:900px">
            <thead>
                <tr>
                    <th>الاسم</th>
                    <th>الفئة</th>
                    @* Dynamic branch columns *@
                    @foreach (var b in branches)
                    {
                        <th style="text-align:center;min-width:75px;white-space:nowrap">
                            <div style="display:flex;flex-direction:column;align-items:center;gap:1px">
                                <span style="font-size:15px">@b.Icon</span>
                                <span style="font-size:9px;color:@b.ColorHex;font-weight:800">@b.NameAr</span>
                            </div>
                        </th>
                    }
                    <th>نوع البيع</th>
                    <th>سعر البيع</th>
                    <th>التكلفة</th>
                    <th>الربح</th>
                    <th>الضريبة</th>
                    <th>السعر شامل الضريبة</th>
                    <th>المخزون</th>
                    <th>الحالة</th>
                    @if (!isReadOnly)
                    {
                        <th>الإجراءات</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    var unitPrice = p.EffectivePrice;
                    var unitCost = p.EffectiveCost;
                    var profit = unitPrice - unitCost;
                    var margin = unitPrice > 0 ? (profit / unitPrice) * 100 : 0;
                    var prodBranchIds = p.ProductBranches?.Select(pb => pb.BranchId).ToHashSet() ?? new();
                    var taxRate = p.TaxRateOverride ?? 14m;
                    var priceWithTaxRaw = unitPrice * (1 + taxRate / 100);
                    var priceWithTax = Math.Round(priceWithTaxRaw, MidpointRounding.AwayFromZero); // round to nearest integer

                    <tr id="row-@p.Id">
                        @* Name *@
                        <td>
                            <div style="display:flex;align-items:center;gap:8px">
                                <span style="font-size:20px">@(p.Category?.Icon ?? "🍽️")</span>
                                <div>
                                    <div style="font-weight:700;font-size:13px">@(p.NameAr ?? p.Name)</div>
                                    @if (!string.IsNullOrEmpty(p.Barcode))
                                    {
                                        <div style="font-size:10px;color:var(--text-muted);font-family:monospace">📊 @p.Barcode</div>
                                    }
                                </div>
                            </div>
                        </td>
                        @* Category *@
                        <td>
                            <span class="badge"
                                  style="background:@(p.Category?.ColorHex ?? "#ccc")20;color:@(p.Category?.ColorHex ?? "#333")">
                                @p.Category?.Icon @p.Category?.NameAr
                            </span>
                            @if (p.Category?.SkipKitchen == true)
                            {
                                <div style="background:#22c55e22;color:#22c55e;font-size:9px;font-weight:800;
                                    padding:1px 5px;border-radius:8px;display:inline-block;margin-top:2px">
                                    ⚡ فوري
                                </div>
                            }
                            @if (p.SkipKitchenOverride == true)
                            {
                                <div style="background:#22c55e22;color:#22c55e;font-size:9px;font-weight:800;
                                    padding:1px 5px;border-radius:8px;display:inline-block;margin-top:2px">
                                    🚀 مباشر (تخصيص)
                                </div>
                            }
                            else if (p.SkipKitchenOverride == false)
                            {
                                <div style="background:#f59e0b22;color:#f59e0b;font-size:9px;font-weight:800;
                                    padding:1px 5px;border-radius:8px;display:inline-block;margin-top:2px">
                                    👨‍🍳 مطبخ إجباري (تخصيص)
                                </div>
                            }
                        </td>
                        @* Branch columns — ✓ colored or — *@
                        @foreach (var b in branches)
                        {
                            var inBranch = prodBranchIds.Contains(b.Id);
                            <td style="text-align:center;vertical-align:middle">
                                @if (inBranch)
                                {
                                    <span style="display:inline-flex;align-items:center;justify-content:center;
                                    width:24px;height:24px;border-radius:50%;
                                    background:@(b.ColorHex)20;color:@b.ColorHex;
                                    font-size:13px;font-weight:900" title="@b.NameAr">✓</span>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted);font-size:13px">—</span>
                                }
                            </td>
                        }
                        @* Sell type *@
                        <td>
                            @if (p.SellByBox)
                            {
                                <div style="font-size:11px">
                                    <span style="background:#f59e0b22;color:#b45309;padding:2px 7px;
                                    border-radius:8px;font-weight:700">📦 كرتون</span>
                                    <div style="color:var(--text-muted);margin-top:2px;font-size:10px">@p.UnitsPerBox وحدة/كرتون</div>
                                </div>
                            }
                            else
                            {
                                <span style="font-size:11px;background:#2563a822;color:#2563a8;
                                padding:2px 7px;border-radius:8px;font-weight:700">🏷️ وحدة</span>
                            }
                        </td>
                        @* Price *@
                        <td>
                            <strong style="color:var(--primary-light)">@unitPrice.ToString("N2") ج.م</strong>
                            @if (p.SellByBox)
                            {
                                <div style="font-size:10px;color:var(--text-muted)">(@p.BoxSellPrice.ToString("N0") كرتون)</div>
                            }
                        </td>
                        @* Cost *@
                        <td>
                            @unitCost.ToString("N2") ج.م
                            @if (p.SellByBox)
                            {
                                <div style="font-size:10px;color:var(--text-muted)">(@p.BoxCostPrice.ToString("N0") كرتون)</div>
                            }
                        </td>
                        @* Profit *@
                        <td>
                            <span style="color:var(--success);font-weight:600">@profit.ToString("N2") ج.م</span>
                            <div style="font-size:10px;color:var(--text-muted)">@margin.ToString("N0")%</div>
                        </td>
                        @* Tax *@
                        <td>
                            @if (p.TaxRateOverride.HasValue)
                            {
                                <span style="background:#ef444422;color:#ef4444;padding:3px 8px;
                                    border-radius:10px;font-size:11px;font-weight:800">
                                    @p.TaxRateOverride.Value.ToString("N0")%
                                    <div style="font-size:9px;opacity:.7">مخصص</div>
                                </span>
                            }
                            else
                            {
                                <span style="color:var(--text-muted);font-size:12px">14%</span>
                            }
                        </td>
                        @* Price with tax *@
                        <td>
                            <strong style="color:#22c55e;font-size:13px">@priceWithTax.ToString("N0") ج.م</strong>
                            @if (taxRate != 14)
                            {
                                <div style="font-size:9px;color:var(--text-muted)">(@taxRate.ToString("N0")% ضريبة)</div>
                            }
                        </td>
                        @* Stock *@
                        <td>
                            @if (p.TrackStock)
                            {
                                <span class="badge @(p.StockQuantity <= p.MinStockAlert ? "badge-danger" : "badge-success")">
                                    @p.StockQuantity
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">غير محدد</span>
                            }
                        </td>
                        @* Status *@
                        <td>
                            <div style="display:flex;flex-direction:column;gap:3px">
                                <span class="badge @(p.IsActive ? "badge-success" : "badge-danger")">
                                    @(p.IsActive ? "نشط" : "غير نشط")
                                </span>
                                <span class="badge @(p.IsAvailable ? "badge-primary" : "badge-secondary")">
                                    @(p.IsAvailable ? "متاح" : "غير متاح")
                                </span>
                            </div>
                        </td>
                        @* Actions *@
                        @if (!isReadOnly)
                        {
                            <td>
                                <div style="display:flex;gap:4px">
                                    <a href="/Admin/EditProduct/@p.Id" class="btn btn-outline btn-sm" title="تعديل">✏️</a>
                                    <button class="btn btn-outline btn-sm"
                                            onclick="toggleProduct(@p.Id,this)"
                                            title="تغيير التوافر">
                                        @(p.IsAvailable ? "🔴" : "🟢")
                                    </button>
                                    <button class="btn btn-danger btn-sm"
                                            onclick="deleteProduct(@p.Id)"
                                            title="حذف">
                                        🗑️
                                    </button>
                                </div>
                            </td>
                        }
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr data-empty="1">
                        <td colspan="@colSpan" style="text-align:center;padding:48px;color:var(--text-muted)">
                            <div style="font-size:40px;margin-bottom:12px">🍽️</div>
                            <p>لا توجد منتجات@(selectedBranch != null ? $" في {selectedBranch.NameAr}" : "")</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="pager no-print" id="productsPager"></div>
</div>

@* The section can't live inside an @if — read-only users need pagination too.
   The action functions are always defined; the buttons that call them are still
   gated by isReadOnly in the markup, and each endpoint is authorised server-side. *@
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => initPager('productsTable', 'productsPager'));

            async function toggleProduct(id, btn) {
                const res = await API.post('/Admin/ToggleProduct', id);
                if (res.success) {
                    btn.textContent = res.isAvailable ? '🔴' : '🟢';
                    Toast.success(res.isAvailable ? 'المنتج متاح الآن' : 'تم إيقاف المنتج');
                }
            }
            async function deleteProduct(id) {
                if (!confirm('هل أنت متأكد من حذف هذا المنتج؟')) return;
                const res = await API.post(`/Admin/DeleteProduct?id=${id}`, {});
                if (res.success) {
                    document.getElementById(`row-${id}`)?.remove();
                    Toast.success('تم حذف المنتج');
                } else {
                    Toast.error('لا يمكن حذف هذا المنتج');
                }
            }
        </script>
}
