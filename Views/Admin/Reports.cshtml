    document.getElementById('refundSummary').innerHTML = `
        <div style="padding:20px;display:grid;grid-template-columns:1fr 1fr;gap:14px">
            <div style="padding:14px;background:#ef444408;border:1px solid #ef444422;border-radius:10px;text-align:center">
                <div style="font-size:10px;font-weight:700;text-transform:uppercase;color:#ef4444;margin-bottom:4px">إجمالي المرتجعات</div>
                <div style="font-size:20px;font-weight:900;color:#ef4444">${Number(d.totalRefunded||0).toFixed(0)} ج.م</div>
            </div>
            <div style="padding:14px;background:var(--bg-secondary);border-radius:10px;text-align:center">
                <div style="font-size:10px;font-weight:700;text-transform:uppercase;color:var(--text-muted);margin-bottom:4px">عدد المعاملات</div>
                <div style="font-size:20px;font-weight:900;color:var(--text-primary)">${d.totalRefundCount||0}</div>
            </div>
            <div style="padding:14px;background:var(--bg-secondary);border-radius:10px;text-align:center">
                <div style="font-size:10px;font-weight:700;text-transform:uppercase;color:var(--text-muted);margin-bottom:4px">% من الإيراد</div>
                <div style="font-size:20px;font-weight:900;color:${parseFloat(pct)>5?'#ef4444':'#22c55e'}">${pct}%</div>
