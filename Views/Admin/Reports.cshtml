    const cfg   = { DineIn:['🪑','#2563a8','صالة'], Takeaway:['🥡','#f59e0b','تيك أواي'], Delivery:['🚗','#22c55e','توصيل'] };
    document.getElementById('orderTypesList').innerHTML = `<div style="padding:16px;display:flex;flex-direction:column;gap:10px">` +
        Object.entries(ot).map(([k,v]) => `
            <div style="display:flex;align-items:center;gap:10px;padding:10px;background:var(--bg-secondary);border-radius:10px">
                <div style="font-size:20px">${cfg[k]?.[0]||'📦'}</div>
                <div style="flex:1">
                    <div style="font-size:12px;font-weight:700">${cfg[k]?.[2]||k}</div>
                    <div style="font-size:10px;color:var(--text-muted)">${((v.count||0)/total*100).toFixed(1)}%</div>
                </div>
                <div style="text-align:left">
                    <div style="font-size:15px;font-weight:900;color:${cfg[k]?.[1]||'#6b7280'}">${v.count||0}</div>
                    <div style="font-size:10px;color:var(--text-muted)">${Number(v.revenue||0).toFixed(0)} ج.م</div>
                </div>
            </div>`).join('') + `</div>`;
}

function renderRefundSummary(d) {
