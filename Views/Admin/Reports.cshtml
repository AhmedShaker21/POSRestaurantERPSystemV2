@{
    ViewData["Title"] = "التقارير والتحليلات";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var branches = ViewBag.Branches as List<RestaurantERP.Models.Branch> ?? new();
}

<style>
.report-toolbar {
    display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-bottom:20px;
    padding:14px 18px; background:var(--card-bg); border:1px solid var(--border-color);
    border-radius:14px; box-shadow:var(--shadow);
}
.toolbar-sep { width:1px; height:28px; background:var(--border-color); margin:0 4px; }
.kpi-strip { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:20px; }
@@media(max-width:900px){ .kpi-strip{ grid-template-columns:repeat(2,1fr); } }
.kpi-card {
    background:var(--card-bg); border:1px solid var(--border-color); border-radius:14px;
    padding:18px 20px; border-left:4px solid var(--kpi-color); box-shadow:var(--shadow);
    position:relative; overflow:hidden;
}
.kpi-card::after { content:''; position:absolute; right:-12px; top:-12px; width:70px; height:70px; border-radius:50%; background:var(--kpi-color); opacity:.07; }
.kpi-label { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.6px; color:var(--text-muted); margin-bottom:6px; }
.kpi-value { font-size:22px; font-weight:900; color:var(--kpi-color); line-height:1; margin-bottom:4px; }
.kpi-sub   { font-size:11px; color:var(--text-muted); }
.kpi-badge { display:inline-flex; align-items:center; gap:3px; font-size:10px; font-weight:700; padding:2px 7px; border-radius:20px; }
.kpi-badge.up   { background:#22c55e20; color:#22c55e; }
.kpi-badge.down { background:#ef444420; color:#ef4444; }
.report-section { margin-bottom:24px; }
.section-title {
    font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:.8px;
    color:var(--text-muted); display:flex; align-items:center; gap:8px;
    margin-bottom:14px; padding-bottom:8px; border-bottom:2px solid var(--border-color);
}
.section-title i { color:var(--primary); }
.pl-table { width:100%; border-collapse:collapse; font-size:13px; }
.pl-table td { padding:8px 12px; border-bottom:1px solid var(--border-color); }
.pl-table tr:last-child td { border-bottom:none; }
.pl-table .pl-header td { font-weight:800; color:var(--text-muted); font-size:10px; text-transform:uppercase; letter-spacing:.5px; background:var(--bg-secondary); }
.pl-table .pl-total td { font-weight:900; font-size:14px; border-top:2px solid var(--border-color); }
.pl-table .pl-section td:first-child { padding-right:24px; color:var(--text-muted); }
.pl-label { font-weight:700; }
.branch-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:12px; }
.branch-cmp-card { background:var(--card-bg); border-radius:12px; padding:16px; border-top:4px solid var(--bc); box-shadow:var(--shadow); }
.period-btn {
    padding:6px 14px; border-radius:20px; border:2px solid var(--border-color);
    background:transparent; color:var(--text-muted); font-size:12px; font-weight:700;
    cursor:pointer; font-family:inherit; transition:all .2s;
}
.period-btn.active { background:var(--primary); border-color:var(--primary); color:#fff; }
.menu-item { display:flex; align-items:center; width:100%; padding:10px 14px; border:none; background:transparent; color:var(--text-primary); font-size:13px; cursor:pointer; text-align:right; font-family:inherit; transition:background .1s; }
.menu-item:hover { background:var(--bg-secondary); }
@@media print {
    .report-toolbar, .no-print, .sidebar, .topbar { display:none !important; }
    .kpi-strip { grid-template-columns:repeat(4,1fr) !important; }
    body { background:#fff !important; }
    .card, .kpi-card { box-shadow:none !important; border:1px solid #ddd !important; }
    * { color:#000 !important; }
}
</style>

<!-- شريط الأدوات -->
<div class="report-toolbar no-print">
    <div style="font-size:12px;font-weight:700;color:var(--text-muted);white-space:nowrap">
        <i class="fas fa-code-branch me-1" style="color:var(--primary)"></i> الفرع:
    </div>
    <select id="branchSelect" class="form-control" style="max-width:200px;border-radius:20px;font-size:12px" onchange="load()">
        <option value="">🌐 جميع الفروع</option>
        @foreach (var b in branches)
        {
            <option value="@b.Id">@b.Icon @b.NameAr</option>
        }
    </select>

    <div class="toolbar-sep"></div>

    <!-- فترة زمنية -->
    <div style="display:flex;gap:8px;align-items:center">
        <button class="period-btn"        onclick="setPeriod(7,this)">7 أيام</button>
        <button class="period-btn"        onclick="setPeriod(30,this)">30 يوم</button>
        <button class="period-btn active" onclick="setPeriod(90,this)">90 يوم</button>
        <button class="period-btn"        onclick="setPeriod(365,this)">سنة</button>
    </div>

    <div class="toolbar-sep"></div>

    <!-- طريقة العرض -->
    <div style="display:flex;gap:8px;align-items:center">
        <span style="font-size:12px;color:var(--text-muted);font-weight:700">عرض:</span>
        <button class="period-btn active" id="viewDaily"   onclick="setView('daily',this)">يومي</button>
        <button class="period-btn"        id="viewWeekly"  onclick="setView('weekly',this)">أسبوعي</button>
        <button class="period-btn"        id="viewMonthly" onclick="setView('monthly',this)">شهري</button>
    </div>

    <div style="flex:1"></div>

    <button class="btn btn-outline btn-sm" onclick="printReport()">
        <i class="fas fa-print me-1"></i>طباعة
    </button>
    <div style="position:relative">
        <button class="btn btn-outline btn-sm" onclick="toggleExportMenu()">
            <i class="fas fa-download me-1"></i>تصدير <i class="fas fa-chevron-down ms-1" style="font-size:10px"></i>
        </button>
        <div id="exportMenu" style="display:none;position:absolute;left:0;top:36px;background:var(--card-bg);border:1px solid var(--border-color);border-radius:10px;min-width:180px;box-shadow:0 8px 24px rgba(0,0,0,.12);z-index:200;overflow:hidden">
            <button class="menu-item" onclick="exportExcel('summary')"><i class="fas fa-table-columns me-2" style="color:#22c55e"></i>ملخص Excel</button>
            <button class="menu-item" onclick="exportExcel('daily')"><i class="fas fa-calendar-days me-2" style="color:#2563a8"></i>بيانات يومية</button>
            <button class="menu-item" onclick="exportExcel('products')"><i class="fas fa-box me-2" style="color:#f59e0b"></i>أفضل المنتجات</button>
            <button class="menu-item" onclick="exportCsv()"><i class="fas fa-file-csv me-2" style="color:#6b7280"></i>تصدير CSV</button>
        </div>
    </div>
</div>

<!-- شريط المؤشرات -->
<div class="kpi-strip" id="kpiStrip">
    @for(int i = 0; i < 8; i++) {
        <div class="kpi-card" style="--kpi-color:#6b7280">
            <div class="kpi-label">جاري التحميل...</div>
            <div class="kpi-value" style="color:#d1d5db">—</div>
        </div>
    }
</div>

<!-- قائمة الأرباح والخسائر -->
<div class="report-section">
    <div class="section-title"><i class="fas fa-file-invoice-dollar"></i>قائمة الأرباح والخسائر</div>
    <div class="card">
        <div class="card-body" style="padding:0">
            <table class="pl-table">
                <thead><tr class="pl-header">
                    <td>البند</td>
                    <td id="plPeriodLabel" style="text-align:left">الفترة</td>
                    <td style="text-align:left">% من الإيراد</td>
                </tr></thead>
                <tbody id="plBody">
                    <tr><td colspan="3" style="text-align:center;padding:30px;color:var(--text-muted)"><i class="fas fa-spinner fa-spin"></i> جاري التحميل...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- رسم بياني للاتجاه -->
<div class="report-section">
    <div class="section-title"><i class="fas fa-chart-line"></i>اتجاه الإيراد والربح</div>
    <div class="card">
        <div class="card-header" style="display:flex;justify-content:space-between;align-items:center">
            <div style="display:flex;gap:8px">
                <button class="period-btn active" id="tRevenue"  onclick="switchMetric('revenue',this)">إيراد</button>
                <button class="period-btn"        id="tProfit"   onclick="switchMetric('profit',this)">ربح</button>
                <button class="period-btn"        id="tOrders"   onclick="switchMetric('orders',this)">طلبات</button>
                <button class="period-btn"        id="tExpenses" onclick="switchMetric('expenses',this)">مصروفات</button>
            </div>
            <span id="trendTotal" style="font-size:13px;font-weight:700;color:var(--primary)"></span>
        </div>
        <div class="card-body" style="padding:20px">
            <div style="height:260px"><canvas id="trendChart"></canvas></div>
        </div>
    </div>
</div>

<!-- مقارنة الفروع -->
<div class="report-section" id="branchSection" style="display:none">
    <div class="section-title"><i class="fas fa-code-branch"></i>مقارنة الفروع</div>
    <div class="branch-grid" id="branchGrid"></div>
</div>

<!-- أفضل المنتجات + الفئات -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px">
    <div class="report-section" style="margin-bottom:0">
        <div class="section-title"><i class="fas fa-trophy"></i>أفضل المنتجات (إيراداً)</div>
        <div class="card">
            <div class="card-body" style="padding:16px" id="topProductsList">
                <div style="text-align:center;padding:30px;color:var(--text-muted)"><i class="fas fa-spinner fa-spin fa-2x"></i></div>
            </div>
        </div>
    </div>
    <div style="display:flex;flex-direction:column;gap:16px">
        <div class="report-section" style="margin-bottom:0;flex:1">
            <div class="section-title"><i class="fas fa-chart-pie"></i>الإيراد حسب الفئة</div>
            <div class="card" style="height:240px">
                <div class="card-body" style="padding:16px;height:100%">
                    <canvas id="categoryChart" style="max-height:200px"></canvas>
                </div>
            </div>
        </div>
        <div class="report-section" style="margin-bottom:0;flex:1">
            <div class="section-title"><i class="fas fa-credit-card"></i>طرق الدفع</div>
            <div class="card"><div class="card-body" style="padding:16px" id="paymentList"></div></div>
        </div>
    </div>
</div>

<!-- أنواع الطلبات + المرتجعات -->
<div style="display:grid;grid-template-columns:auto 1fr;gap:20px;margin-bottom:24px">
    <div class="report-section" style="margin-bottom:0;min-width:260px">
        <div class="section-title"><i class="fas fa-list-check"></i>أنواع الطلبات</div>
        <div class="card" id="orderTypesList"></div>
    </div>
    <div class="report-section" style="margin-bottom:0">
        <div class="section-title"><i class="fas fa-rotate-left"></i>ملخص المرتجعات</div>
        <div class="card" id="refundSummary"></div>
    </div>
</div>

<!-- جدول البيانات -->
<div class="report-section">
    <div class="section-title" style="justify-content:space-between">
        <div style="display:flex;align-items:center;gap:8px"><i class="fas fa-table"></i><span id="tableTitle">التفصيل اليومي</span></div>
        <input type="text" id="tableSearch" class="form-control" style="max-width:220px;height:30px;font-size:12px;border-radius:20px" placeholder="🔍 بحث..." oninput="filterTable()">
    </div>
    <div class="card">
        <div style="overflow-x:auto">
            <table class="data-table" id="dataTable">
                <thead><tr id="dataTableHead"></tr></thead>
                <tbody id="dataTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/lib/js/xlsx.full.min.js"></script>
<script>
let reportData  = null;
let currentDays = 90;
let currentView = 'daily';
let currentMetricKey = 'revenue';
let trendChartObj = null, catChartObj = null;

const branches = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    (ViewBag.Branches as List<RestaurantERP.Models.Branch> ?? new()).Select(b => new {
        id=b.Id, name=b.Name, nameAr=b.NameAr, icon=b.Icon, colorHex=b.ColorHex
    })));

function setPeriod(days, btn) {
    currentDays = days;
    document.querySelectorAll('.period-btn').forEach(b => {
        if (['7 أيام','30 يوم','90 يوم','سنة'].includes(b.textContent.trim()))
            b.classList.remove('active');
    });
    btn.classList.add('active');
    load();
}

function setView(v, btn) {
    currentView = v;
    ['viewDaily','viewWeekly','viewMonthly'].forEach(id => document.getElementById(id)?.classList.remove('active'));
    btn.classList.add('active');
    if (reportData) { renderTrend(reportData); renderDataTable(reportData); }
}

function switchMetric(key, btn) {
    currentMetricKey = key;
    document.querySelectorAll('#tRevenue,#tProfit,#tOrders,#tExpenses').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    if (reportData) renderTrend(reportData);
}

async function load() {
    const branchId = document.getElementById('branchSelect').value;
    const url = `/Admin/GetReportData?days=${currentDays}${branchId ? '&branchId='+branchId : ''}`;
    Loading.show();
    try {
        reportData = await API.get(url);
        renderAll(reportData);
    } catch(e) { Toast.error('فشل تحميل بيانات التقرير'); }
    Loading.hide();
}

function renderAll(d) {
    renderKPIs(d); renderPL(d); renderTrend(d); renderBranchComparison(d);
    renderTopProducts(d); renderCategoryChart(d); renderPaymentMethods(d);
    renderOrderTypes(d); renderRefundSummary(d); renderDataTable(d);
}

function renderKPIs(d) {
    const fmt  = v => Number(v||0).toLocaleString('ar-EG', {maximumFractionDigits:0});
    const fmtD = v => Number(v||0).toLocaleString('ar-EG', {minimumFractionDigits:2,maximumFractionDigits:2});
    const badge = v => v != null ? `<span class="kpi-badge ${v>=0?'up':'down'}"><i class="fas fa-arrow-${v>=0?'up':'down'}"></i>${Math.abs(v).toFixed(1)}%</span>` : '';
    const kpis = [
        { label:'صافي الإيراد',        value:`${fmt(d.totalRevenue)} ج.م`,     color:'#2563a8', icon:'fa-coins',         sub: badge(d.revenueGrowth) },
        { label:'صافي الربح',          value:`${fmt(d.netProfit)} ج.م`,         color: d.netProfit>=0?'#22c55e':'#ef4444', icon:'fa-arrow-trend-up',  sub:`الهامش: ${d.profitMargin}%` },
        { label:'إجمالي الطلبات',      value: fmt(d.totalOrders),              color:'#f59e0b', icon:'fa-receipt',        sub: badge(d.ordersGrowth) },
        { label:'متوسط قيمة الطلب',    value:`${fmtD(d.avgOrderValue)} ج.م`,   color:'#8b5cf6', icon:'fa-chart-bar',      sub:`${d.periodDays} يوم` },
        { label:'تكلفة البضاعة',       value:`${fmt(d.totalCogs)} ج.م`,        color:'#ef4444', icon:'fa-box-open',       sub:'تكلفة المنتجات المباعة' },
        { label:'المصروفات',           value:`${fmt(d.totalExpenses)} ج.م`,    color:'#6b7280', icon:'fa-file-invoice',   sub:'المصروفات التشغيلية' },
        { label:'إجمالي المرتجعات',    value:`${fmt(d.totalRefunded)} ج.م`,    color:'#f97316', icon:'fa-rotate-left',    sub:`${d.totalRefundCount} معاملة` },
        { label:'الربح الإجمالي',      value:`${fmt(d.grossProfit)} ج.م`,      color:'#10b981', icon:'fa-sack-dollar',    sub:'قبل المصروفات' },
    ];
    document.getElementById('kpiStrip').innerHTML = kpis.map(k => `
        <div class="kpi-card" style="--kpi-color:${k.color}">
            <div class="kpi-label"><i class="fas ${k.icon} me-1"></i>${k.label}</div>
            <div class="kpi-value">${k.value}</div>
            <div class="kpi-sub">${k.sub||''}</div>
        </div>`).join('');
}

function renderPL(d) {
    const rev  = d.totalRevenue || 0;
    const fmt  = v => `<strong>${Number(v).toLocaleString('ar-EG',{minimumFractionDigits:2})}</strong> ج.م`;
    const pct  = v => rev > 0 ? `${(v/rev*100).toFixed(1)}%` : '—';
    const gross= d.totalRevenue + (d.totalRefunded||0);
    const branchId = document.getElementById('branchSelect').value;
    const branchName = branchId ? (branches.find(b=>b.id==branchId)?.nameAr || 'الفرع المحدد') : 'جميع الفروع';
    document.getElementById('plPeriodLabel').textContent = `${branchName} — آخر ${currentDays} يوم`;
    document.getElementById('plBody').innerHTML = `
        <tr class="pl-header"><td colspan="3" style="padding:10px 12px;background:#2563a808;color:#2563a8;font-weight:800">الإيرادات</td></tr>
        <tr><td class="pl-label">إجمالي المبيعات</td><td style="text-align:left">${fmt(gross)}</td><td style="text-align:left;color:var(--text-muted)">${pct(gross)}</td></tr>
        <tr class="pl-section"><td>(-) المرتجعات</td><td style="text-align:left;color:#ef4444">−${fmt(d.totalRefunded||0)}</td><td style="text-align:left;color:var(--text-muted)">-${pct(d.totalRefunded||0)}</td></tr>
        <tr class="pl-total"><td>صافي الإيراد</td><td style="text-align:left;color:#2563a8">${fmt(rev)}</td><td style="text-align:left;color:#2563a8">100%</td></tr>
        <tr class="pl-header"><td colspan="3" style="padding:10px 12px;background:#ef444408;color:#ef4444;font-weight:800">تكلفة البضاعة المباعة</td></tr>
        <tr><td class="pl-label">إجمالي التكلفة</td><td style="text-align:left;color:#ef4444">${fmt(d.totalCogs||0)}</td><td style="text-align:left;color:var(--text-muted)">${pct(d.totalCogs||0)}</td></tr>
        <tr class="pl-total"><td>الربح الإجمالي</td><td style="text-align:left;color:#10b981">${fmt(d.grossProfit||0)}</td><td style="text-align:left;color:#10b981">${pct(d.grossProfit||0)}</td></tr>
        <tr class="pl-header"><td colspan="3" style="padding:10px 12px;background:#6b728008;color:#6b7280;font-weight:800">المصروفات التشغيلية</td></tr>
        <tr><td class="pl-label">إجمالي المصروفات</td><td style="text-align:left;color:#6b7280">${fmt(d.totalExpenses||0)}</td><td style="text-align:left;color:var(--text-muted)">${pct(d.totalExpenses||0)}</td></tr>
        <tr class="pl-total" style="font-size:16px">
            <td style="color:${d.netProfit>=0?'#22c55e':'#ef4444'}">صافي الربح</td>
            <td style="text-align:left;color:${d.netProfit>=0?'#22c55e':'#ef4444'}">${fmt(d.netProfit||0)}</td>
            <td style="text-align:left;color:${d.netProfit>=0?'#22c55e':'#ef4444'}">${d.profitMargin||0}%</td>
        </tr>`;
}

function renderTrend(d) {
    const series = currentView === 'weekly'  ? d.weeklySales  :
                   currentView === 'monthly' ? d.monthlySales : d.dailySales;
    const labels = series.map(s => s.date || s.week || s.month);
    const cfg = {
        revenue:  { key:'revenue',  label:'صافي الإيراد (ج.م)', color:'#2563a8' },
        profit:   { key:'profit',   label:'صافي الربح (ج.م)',  color:'#22c55e' },
        expenses: { key:'expenses', label:'المصروفات (ج.م)',    color:'#ef4444' },
        orders:   { key:'orders',   label:'الطلبات',             color:'#f59e0b' },
    }[currentMetricKey] || { key:'revenue', label:'الإيراد', color:'#2563a8' };
    const values = series.map(s => s[cfg.key] ?? 0);
    const total  = values.reduce((a,b) => a + b, 0);
    document.getElementById('trendTotal').textContent = `الإجمالي: ${total.toLocaleString('ar-EG',{minimumFractionDigits: currentMetricKey==='orders'?0:2})} ${currentMetricKey==='orders'?'طلب':'ج.م'}`;
    if (trendChartObj) trendChartObj.destroy();
    trendChartObj = createChart('trendChart', {
        type: 'line',
        data: { labels, datasets: [{
            label: cfg.label, data: values,
            borderColor: cfg.color, backgroundColor: cfg.color + '18',
            borderWidth: 2.5, fill: true, tension: 0.4,
            pointRadius: labels.length > 60 ? 0 : 3, pointHoverRadius: 5
        }]},
        options: {
            responsive:true, maintainAspectRatio:false,
            plugins: { legend:{ display:false } },
            scales: {
                x: { grid:{ display:false }, ticks:{ maxTicksLimit:14, font:{size:10} } },
                y: { beginAtZero:true, grid:{ color:'rgba(150,150,150,.1)' }, ticks:{ callback: v => v.toLocaleString(), font:{size:10} } }
            }
        }
    });
}

function renderBranchComparison(d) {
    const bData = d.branchBreakdown || [];
    const sec   = document.getElementById('branchSection');
    const branchId = document.getElementById('branchSelect').value;
    if (bData.length === 0 || branchId) { sec.style.display = 'none'; return; }
    sec.style.display = '';
    const maxRev = Math.max(...bData.map(b => b.revenue), 1);
    document.getElementById('branchGrid').innerHTML = bData.map(b => `
        <div class="branch-cmp-card" style="--bc:${b.colorHex}">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px">
                <span style="font-size:22px">${b.icon}</span>
                <div>
                    <div style="font-weight:800;font-size:13px">${b.branchName}</div>
                    <div style="font-size:10px;color:var(--text-muted)">${b.orders} طلب</div>
                </div>
            </div>
            <div style="margin-bottom:6px">
                <div style="display:flex;justify-content:space-between;font-size:11px;margin-bottom:3px">
                    <span style="color:var(--text-muted)">نسبة الإيراد</span>
                    <span style="font-weight:700;color:${b.colorHex}">${(b.revenue/maxRev*100).toFixed(0)}%</span>
                </div>
                <div style="background:var(--bg-secondary);border-radius:4px;height:6px">
                    <div style="width:${(b.revenue/maxRev*100).toFixed(0)}%;background:${b.colorHex};height:100%;border-radius:4px"></div>
                </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;font-size:11px">
                <div style="background:var(--bg-secondary);border-radius:6px;padding:6px">
                    <div style="color:var(--text-muted)">إيراد</div>
                    <div style="font-weight:800;color:${b.colorHex}">${Number(b.revenue).toFixed(0)}</div>
                </div>
                <div style="background:var(--bg-secondary);border-radius:6px;padding:6px">
                    <div style="color:var(--text-muted)">ربح</div>
                    <div style="font-weight:800;color:${b.profit>=0?'#22c55e':'#ef4444'}">${Number(b.profit).toFixed(0)}</div>
                </div>
            </div>
        </div>`).join('');
}

