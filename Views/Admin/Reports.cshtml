    const colors = { Cash:'#22c55e', Card:'#2563a8', Digital:'#8b5cf6' };
    const labels = { Cash:'نقدي', Card:'كارت', Digital:'إلكتروني' };
    const total  = Object.values(pm).reduce((a,b) => a + (b.count||0), 0) || 1;
    document.getElementById('paymentList').innerHTML = Object.entries(pm).map(([k,v]) => `
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
            <div style="width:32px;height:32px;border-radius:8px;background:${colors[k]||'#6b7280'}18;color:${colors[k]||'#6b7280'};display:flex;align-items:center;justify-content:center;flex-shrink:0">
                <i class="fas ${icons[k]||'fa-money-bill'}" style="font-size:14px"></i>
            </div>
            <div style="flex:1">
                <div style="display:flex;justify-content:space-between;margin-bottom:3px">
                    <span style="font-size:12px;font-weight:700">${labels[k]||k}</span>
                    <span style="font-size:11px;color:var(--text-muted)">${v.count||0} طلب · ${Number(v.revenue||0).toFixed(0)} ج.م</span>
                </div>
                <div style="background:var(--bg-secondary);border-radius:3px;height:5px">
                    <div style="width:${((v.count||0)/total*100).toFixed(0)}%;background:${colors[k]||'#6b7280'};height:100%;border-radius:3px"></div>
                </div>
            </div>
        </div>`).join('');
}

function renderOrderTypes(d) {
    const ot    = d.orderTypes || {};
