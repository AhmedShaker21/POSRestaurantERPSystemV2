            <div style="flex:1;min-width:0">
                <div style="font-size:12px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:3px">${p.productNameAr||p.productName}</div>
                <div style="background:var(--bg-secondary);border-radius:3px;height:4px"><div style="width:${(p.totalRevenue/maxRev*100).toFixed(0)}%;background:var(--primary);height:100%;border-radius:3px"></div></div>
            </div>
            <div style="text-align:left;flex-shrink:0;min-width:90px">
                <div style="font-weight:800;font-size:12px">${Number(p.totalRevenue||0).toFixed(0)} ج.م</div>
                <div style="font-size:10px;color:var(--text-muted)">${p.totalQty} مباع · ${p.margin||0}% هامش</div>
            </div>
        </div>`).join('');
}

function renderCategoryChart(d) {
    if (catChartObj) catChartObj.destroy();
    const cats = d.categoryRevenue || [];
    catChartObj = createChart('categoryChart', {
        type:'doughnut',
        data:{ labels: cats.map(c=>c.categoryNameAr||c.categoryName), datasets:[{ data: cats.map(c=>c.revenue), backgroundColor: cats.map(c=>c.colorHex||'#2563a8'), borderWidth:2 }] },
        options:{ responsive:true, maintainAspectRatio:true, plugins:{ legend:{ position:'right', labels:{ font:{size:10}, padding:8, boxWidth:10 } } }, cutout:'60%' }
    });
}

function renderPaymentMethods(d) {
    const pm     = d.paymentMethods || {};
