let tableRawData = [];
function renderDataTable(d) {
    const series   = currentView === 'weekly'  ? d.weeklySales : currentView === 'monthly' ? d.monthlySales : d.dailySales;
    const keyLabel = currentView === 'weekly'  ? 'الأسبوع' : currentView === 'monthly' ? 'الشهر' : 'التاريخ';
    const keyField = currentView === 'weekly'  ? 'week' : currentView === 'monthly' ? 'month' : 'date';
    const viewAr   = { daily:'اليومي', weekly:'الأسبوعي', monthly:'الشهري' };
    document.getElementById('tableTitle').textContent = `التفصيل ${viewAr[currentView]}`;
    document.getElementById('dataTableHead').innerHTML = `<th>${keyLabel}</th><th>الإيراد</th><th>الطلبات</th><th>المصروفات</th><th>المرتجعات</th><th>الربح</th><th>الهامش</th>`;
    tableRawData = series || [];
    renderTableRows(tableRawData);
}

function renderTableRows(rows) {
    const totRev  = rows.reduce((a,r) => a + (r.revenue||0),  0);
    const totExp  = rows.reduce((a,r) => a + (r.expenses||0), 0);
    const totRef  = rows.reduce((a,r) => a + (r.refunds||0),  0);
    const totProf = rows.reduce((a,r) => a + (r.profit||0),   0);
    const totOrd  = rows.reduce((a,r) => a + (r.orders||0),   0);
    const totMarg = totRev > 0 ? (totProf/totRev*100).toFixed(1) : '—';
    const keyField = currentView === 'weekly' ? 'week' : currentView === 'monthly' ? 'month' : 'date';
    document.getElementById('dataTableBody').innerHTML =
        rows.map(r => {
            const margin = r.revenue > 0 ? ((r.profit||0)/r.revenue*100).toFixed(1) : '0.0';
            const pc = r.profit >= 0 ? '#22c55e' : '#ef4444';
            return `<tr>
                <td><strong>${r[keyField]||r.date}</strong>${r.dayNameAr?`<span style="color:var(--text-muted);font-size:10px;margin-right:4px">${r.dayNameAr}</span>`:''}</td>
                <td>${Number(r.revenue||0).toFixed(2)}</td>
                <td>${r.orders||0}</td>
                <td style="color:#6b7280">${Number(r.expenses||0).toFixed(2)}</td>
                <td style="color:#ef4444">${Number(r.refunds||0).toFixed(2)}</td>
                <td style="color:${pc};font-weight:700">${Number(r.profit||0).toFixed(2)}</td>
                <td style="color:${parseFloat(margin)>0?'#22c55e':'#ef4444'}">${margin}%</td>
            </tr>`;
        }).join('') +
        `<tr style="background:var(--bg-secondary);font-weight:700;border-top:2px solid var(--border-color)">
            <td>الإجمالي</td><td>${totRev.toFixed(2)}</td><td>${totOrd}</td>
            <td style="color:#6b7280">${totExp.toFixed(2)}</td>
            <td style="color:#ef4444">${totRef.toFixed(2)}</td>
            <td style="color:${totProf>=0?'#22c55e':'#ef4444'}">${totProf.toFixed(2)}</td>
            <td style="color:${parseFloat(totMarg)>0?'#22c55e':'#ef4444'}">${totMarg}%</td>
        </tr>`;
}

function filterTable() {
    const q = document.getElementById('tableSearch').value.toLowerCase();
    const filtered = q ? tableRawData.filter(r => JSON.stringify(r).toLowerCase().includes(q)) : tableRawData;
    renderTableRows(filtered);
}

function toggleExportMenu() {
    const m = document.getElementById('exportMenu');
    m.style.display = m.style.display === 'none' ? '' : 'none';
}
document.addEventListener('click', e => {
    if (!e.target.closest('#exportMenu') && !e.target.closest('[onclick*="toggleExportMenu"]'))
        document.getElementById('exportMenu').style.display = 'none';
});

function exportExcel(type) {
    if (!reportData) { Toast.warning('يرجى تحميل البيانات أولاً'); return; }
    if (typeof XLSX === 'undefined') {
        Toast.error('مكتبة Excel غير محمّلة — تأكد من وجود /lib/js/xlsx.full.min.js');
        return;
    }
    const wb = XLSX.utils.book_new();
    const branchSel  = document.getElementById('branchSelect');
    const branchName = branchSel.options[branchSel.selectedIndex].text;

    if (type === 'summary') {
        const plRows = [
            ['قائمة الأرباح والخسائر','',''],
            ['الفرع', branchName, ''],
            ['الفترة', `آخر ${currentDays} يوم`, ''],
            ['تاريخ التقرير', new Date().toLocaleString('ar-EG'), ''],
            ['','',''],
            ['البند','المبلغ (ج.م)','% من الإيراد'],
            ['إجمالي المبيعات', reportData.totalRevenue+(reportData.totalRefunded||0), ''],
            ['(-) المرتجعات', -(reportData.totalRefunded||0), ''],
            ['صافي الإيراد', reportData.totalRevenue, '100%'],
            ['','',''],
            ['إجمالي التكلفة (COGS)', reportData.totalCogs, `${reportData.totalRevenue>0?((reportData.totalCogs||0)/reportData.totalRevenue*100).toFixed(1):0}%`],
            ['الربح الإجمالي', reportData.grossProfit, `${reportData.totalRevenue>0?((reportData.grossProfit||0)/reportData.totalRevenue*100).toFixed(1):0}%`],
            ['','',''],
            ['إجمالي المصروفات', reportData.totalExpenses, `${reportData.totalRevenue>0?((reportData.totalExpenses||0)/reportData.totalRevenue*100).toFixed(1):0}%`],
            ['صافي الربح', reportData.netProfit, `${reportData.profitMargin}%`],
            ['','',''],
            ['إجمالي الطلبات', reportData.totalOrders,''],
            ['متوسط قيمة الطلب', reportData.avgOrderValue,''],
            ['عدد معاملات المرتجعات', reportData.totalRefundCount,''],
        ];
        XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(plRows), 'الأرباح والخسائر');
    }

    if (type === 'daily') {
        const series   = currentView === 'weekly' ? reportData.weeklySales : currentView === 'monthly' ? reportData.monthlySales : reportData.dailySales;
        const keyField = currentView === 'weekly' ? 'week' : currentView === 'monthly' ? 'month' : 'date';
        const viewAr   = { daily:'يومي', weekly:'أسبوعي', monthly:'شهري' };
        const headers  = ['التاريخ','الإيراد (ج.م)','الطلبات','المصروفات (ج.م)','المرتجعات (ج.م)','الربح (ج.م)','الهامش %'];
        const rows     = [headers, ...series.map(r => [
            r[keyField]||r.date, r.revenue||0, r.orders||0, r.expenses||0, r.refunds||0, r.profit||0,
            r.revenue > 0 ? ((r.profit/r.revenue)*100).toFixed(1) : 0
        ])];
        XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(rows), `تفصيل ${viewAr[currentView]}`);
    }

    if (type === 'products') {
        const headers = ['المنتج','المنتج (عربي)','الكمية المباعة','الإيراد (ج.م)','التكلفة (ج.م)','الربح (ج.م)','الهامش %'];
        const rows    = [headers, ...(reportData.topProducts||[]).map(p => [p.productName,p.productNameAr,p.totalQty,p.totalRevenue,p.cost,p.profit,p.margin])];
        XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(rows), 'أفضل المنتجات');
    }

    if ((reportData.branchBreakdown||[]).length > 0) {
        const headers = ['الفرع','الإيراد (ج.م)','المصروفات (ج.م)','الربح (ج.م)','الطلبات'];
        const rows    = [headers, ...reportData.branchBreakdown.map(b => [b.branchName,b.revenue,b.expenses,b.profit,b.orders])];
        XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(rows), 'مقارنة الفروع');
    }

    XLSX.writeFile(wb, `تقرير_${branchName.replace(/[^a-z0-9\u0600-\u06ff]/gi,'_')}_${new Date().toISOString().split('T')[0]}.xlsx`);
    document.getElementById('exportMenu').style.display = 'none';
}

function exportCsv() {
    if (!reportData) return;
    const series  = reportData.dailySales || [];
    const headers = ['التاريخ','الإيراد','الطلبات','المصروفات','المرتجعات','الربح'];
    const rows    = series.map(r => [r.date,r.revenue||0,r.orders||0,r.expenses||0,r.refunds||0,r.profit||0]);
    const csv     = [headers,...rows].map(r => r.join(',')).join('\n');
    const blob    = new Blob(['\uFEFF'+csv], { type:'text/csv;charset=utf-8' });
    const a       = document.createElement('a');
    a.href        = URL.createObjectURL(blob);
    a.download    = `تقرير_${new Date().toISOString().split('T')[0]}.csv`;
    a.click();
    document.getElementById('exportMenu').style.display = 'none';
}

function printReport() { window.print(); }
