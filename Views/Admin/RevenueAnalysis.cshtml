@model RestaurantERP.Controllers.RevenueAnalysisViewModel
@{
    ViewData["Title"] = "تحليل الإيرادات والأرباح";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.PageTitle = "تحليل الإيرادات والأرباح";
    var branches = ViewBag.Branches as List<RestaurantERP.Models.Branch> ?? new();
    string M(decimal d) => d.ToString("N2");
    string P(decimal d) => d.ToString("N1") + "%";

    var typeAr = new Dictionary<string, string> {
        ["DineIn"] = "صالة", ["Takeaway"] = "تيك أواي", ["Delivery"] = "توصيل"
    };
    var payAr = new Dictionary<string, string> {
        ["Cash"] = "كاش", ["Card"] = "بطاقة", ["Wallet"] = "محفظة", ["Mixed"] = "مختلط"
    };
}

<div class="page-header no-print">
    <div>
        <h1 class="page-title">💹 تحليل الإيرادات والأرباح</h1>
        <p class="page-subtitle">من @Model.From.ToString("yyyy-MM-dd") إلى @Model.To.ToString("yyyy-MM-dd") — @Model.OrderCount طلب</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline" href="/Admin/DailyReport">🧾 التقرير اليومي</a>
        <button class="btn btn-primary" onclick="window.print()">🖨️ طباعة</button>
    </div>
</div>

<div class="card no-print" style="margin-bottom:20px">
    <div class="card-body">
        <form method="get" class="d-flex gap-3 align-items-end" style="flex-wrap:wrap">
            <div class="form-group" style="margin:0">
                <label class="form-label">من تاريخ</label>
                <input type="date" name="from" class="form-control" value="@Model.From.ToString("yyyy-MM-dd")">
            </div>
            <div class="form-group" style="margin:0">
                <label class="form-label">إلى تاريخ</label>
                <input type="date" name="to" class="form-control" value="@Model.To.ToString("yyyy-MM-dd")">
            </div>
            <div class="form-group" style="margin:0">
                <label class="form-label">الفرع</label>
                <select name="branchId" class="form-control">
                    <option value="">كل الفروع</option>
                    @foreach (var b in branches)
                    {
                        <option value="@b.Id" selected="@(ViewBag.BranchId != null && (int)ViewBag.BranchId == b.Id)">@b.NameAr</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">تحديث</button>
        </form>
    </div>
</div>

<div class="print-only" style="text-align:center;margin-bottom:16px">
    <h2>تحليل الإيرادات والأرباح</h2>
    <p>من @Model.From.ToString("yyyy-MM-dd") إلى @Model.To.ToString("yyyy-MM-dd")</p>
</div>

@* ═════════ P&L WATERFALL — the core answer ═════════ *@
<div class="card" style="margin-bottom:20px">
    <div class="card-header"><h3 class="card-title">📊 قائمة الأرباح والخسائر — من أين جاء الربح؟</h3></div>
    <div class="table-container">
        <table class="data-table">
            <tbody>
                <tr>
                    <td style="font-weight:700">إجمالي المبيعات (قبل الخصم)</td>
                    <td style="text-align:left;font-weight:700">@M(Model.GrossSales) ج.م</td>
                    <td style="color:var(--text-muted);font-size:11px">@Model.ItemsSold صنف مباع في @Model.OrderCount طلب</td>
                </tr>
                <tr>
                    <td style="color:#F59E0B">− الخصومات الممنوحة</td>
                    <td style="text-align:left;color:#F59E0B">-@M(Model.Discounts) ج.م</td>
                    <td style="color:var(--text-muted);font-size:11px">إيراد تنازلت عنه للعملاء</td>
                </tr>
                <tr>
                    <td style="color:#EF4444">− المرتجعات</td>
                    <td style="text-align:left;color:#EF4444">-@M(Model.Refunded) ج.م</td>
                    <td style="color:var(--text-muted);font-size:11px">مبيعات رجعت بعد إتمامها</td>
                </tr>
                <tr style="background:var(--bg-secondary)">
                    <td style="font-weight:900;font-size:15px">= صافي الإيراد</td>
                    <td style="text-align:left;font-weight:900;font-size:15px">@M(Model.NetRevenue) ج.م</td>
                    <td style="color:var(--text-muted);font-size:11px">متوسط الطلب @M(Model.AvgOrderValue) ج.م</td>
                </tr>
                <tr>
                    <td style="color:#FF9800">− تكلفة البضاعة المباعة</td>
                    <td style="text-align:left;color:#FF9800">-@M(Model.Cogs) ج.م</td>
                    <td style="color:var(--text-muted);font-size:11px">سعر تكلفة الأصناف اللي اتباعت فعليًا</td>
                </tr>
                <tr style="background:var(--bg-secondary)">
                    <td style="font-weight:900;font-size:15px;color:#16A34A">= مجمل الربح</td>
                    <td style="text-align:left;font-weight:900;font-size:15px;color:#16A34A">@M(Model.GrossProfit) ج.م</td>
                    <td style="font-weight:700;color:#16A34A">هامش @P(Model.GrossMargin)</td>
                </tr>
                <tr>
                    <td style="color:#DC2626">− المصروفات التشغيلية</td>
                    <td style="text-align:left;color:#DC2626">-@M(Model.OperatingExpenses) ج.م</td>
                    <td style="color:var(--text-muted);font-size:11px">إيجار، رواتب، كهرباء… (شوف التفصيل تحت)</td>
                </tr>
                <tr>
                    <td style="color:#78716C">− الهالك والتالف</td>
                    <td style="text-align:left;color:#78716C">-@M(Model.WasteValue) ج.م</td>
                    <td style="color:var(--text-muted);font-size:11px">بضاعة اتسجلت هالك في المخزن</td>
                </tr>
                <tr style="background:@(Model.NetProfit >= 0 ? "#16A34A18" : "#DC262618")">
                    <td style="font-weight:900;font-size:17px">= صافي الربح</td>
                    <td style="text-align:left;font-weight:900;font-size:17px;color:@(Model.NetProfit >= 0 ? "#16A34A" : "#DC2626")">@M(Model.NetProfit) ج.م</td>
                    <td style="font-weight:700">هامش @P(Model.NetMargin)</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="stats-grid" style="margin-bottom:24px">
    <div class="stat-card">
        <div class="stat-icon" style="background:#16A34A22;color:#16A34A"><i class="fas fa-cash-register"></i></div>
        <div class="stat-value">@M(Model.Collected)</div>
        <div class="stat-label">مُحصَّل فعليًا</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:#DC262622;color:#DC2626"><i class="fas fa-hourglass-half"></i></div>
        <div class="stat-value">@M(Model.Outstanding)</div>
        <div class="stat-label">حسابات مفتوحة لم تُحصَّل</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:#8B5CF622;color:#8B5CF6"><i class="fas fa-truck-loading"></i></div>
        <div class="stat-value">@M(Model.WarehousePurchases)</div>
        <div class="stat-label">مشتريات المخزن بالفترة</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:#45B7D122;color:#45B7D1"><i class="fas fa-receipt"></i></div>
        <div class="stat-value">@M(Model.AvgOrderValue)</div>
        <div class="stat-label">متوسط قيمة الطلب</div>
    </div>
</div>

@* ═════════ BREAKDOWNS ═════════ *@
@await Html.PartialAsync("_ProfitBreakdown", new RestaurantERP.Controllers.BreakdownVm {
    Title = "🍽️ الإيراد والربح حسب الصنف", ColLabel = "الصنف", QtyLabel = "الكمية",
    Rows = Model.ByProduct, ShowProfit = true, Total = Model.NetRevenue })

@await Html.PartialAsync("_ProfitBreakdown", new RestaurantERP.Controllers.BreakdownVm {
    Title = "📂 الإيراد والربح حسب الفئة", ColLabel = "الفئة", QtyLabel = "الكمية",
    Rows = Model.ByCategory, ShowProfit = true, Total = Model.NetRevenue })

@await Html.PartialAsync("_ProfitBreakdown", new RestaurantERP.Controllers.BreakdownVm {
    Title = "🛎️ الإيراد حسب نوع الطلب", ColLabel = "النوع", QtyLabel = "عدد الطلبات",
    Rows = Model.ByOrderType.Select(r => new RestaurantERP.Controllers.ProfitRow {
        Label = typeAr.GetValueOrDefault(r.Label, r.Label), Quantity = r.Quantity, Revenue = r.Revenue, Cost = r.Cost }).ToList(),
    ShowProfit = true, Total = Model.NetRevenue })

@if (Model.ByBranch.Count > 1)
{
    @await Html.PartialAsync("_ProfitBreakdown", new RestaurantERP.Controllers.BreakdownVm {
        Title = "🏢 الإيراد والربح حسب الفرع", ColLabel = "الفرع", QtyLabel = "عدد الطلبات",
        Rows = Model.ByBranch, ShowProfit = true, Total = Model.NetRevenue })
}

@await Html.PartialAsync("_ProfitBreakdown", new RestaurantERP.Controllers.BreakdownVm {
    Title = "👤 الإيراد حسب الكاشير", ColLabel = "الكاشير", QtyLabel = "عدد الطلبات",
    Rows = Model.ByCashier, ShowProfit = true, Total = Model.NetRevenue })

@await Html.PartialAsync("_ProfitBreakdown", new RestaurantERP.Controllers.BreakdownVm {
    Title = "💳 الإيراد حسب طريقة الدفع", ColLabel = "الطريقة", QtyLabel = "عدد الطلبات",
    Rows = Model.ByPaymentMethod.Select(r => new RestaurantERP.Controllers.ProfitRow {
        Label = payAr.GetValueOrDefault(r.Label, r.Label), Quantity = r.Quantity, Revenue = r.Revenue, Cost = 0 }).ToList(),
    ShowProfit = false, Total = Model.NetRevenue })

@await Html.PartialAsync("_ProfitBreakdown", new RestaurantERP.Controllers.BreakdownVm {
    Title = "🕐 الإيراد حسب ساعة اليوم", ColLabel = "الساعة", QtyLabel = "عدد الطلبات",
    Rows = Model.ByHour, ShowProfit = false, Total = Model.NetRevenue })

@await Html.PartialAsync("_ProfitBreakdown", new RestaurantERP.Controllers.BreakdownVm {
    Title = "📅 الإيراد والربح يومًا بيوم", ColLabel = "اليوم", QtyLabel = "عدد الطلبات",
    Rows = Model.ByDay, ShowProfit = true, Total = Model.NetRevenue })

@await Html.PartialAsync("_ProfitBreakdown", new RestaurantERP.Controllers.BreakdownVm {
    Title = "💸 المصروفات التشغيلية حسب البند", ColLabel = "البند", QtyLabel = "عدد العمليات",
    Rows = Model.ByExpenseCategory, ShowProfit = false, Total = Model.OperatingExpenses })
