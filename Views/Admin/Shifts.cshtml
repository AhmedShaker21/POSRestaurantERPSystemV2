@model IEnumerable<RestaurantERP.Models.Shift>
@{
    ViewData["Title"] = "Shifts";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var activeShifts = Model.Where(s => !s.IsClosed).ToList();
    var closedShifts = Model.Where(s => s.IsClosed).ToList();

    var settingsDict = ViewBag.Settings as Dictionary<string, string> ?? new();
    var settingsJson = System.Text.Json.JsonSerializer.Serialize(settingsDict,
        new System.Text.Json.JsonSerializerOptions
        {
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });
}

<div class="page-header no-print">
    <div>
        <h1 class="page-title" data-t="shifts">Shifts</h1>
        <p class="page-subtitle">
            @activeShifts.Count <span data-t="activeShifts">active</span> /
            @closedShifts.Count <span data-t="closedShifts">closed</span>
        </p>
    </div>
</div>

@if (activeShifts.Any())
{
    <div style="margin-bottom:24px">
        <h3 style="font-size:16px;font-weight:600;margin-bottom:12px;color:var(--primary)" data-t="activeShifts">
            Active Shifts
        </h3>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px">
            @foreach (var shift in activeShifts)
            {
                var duration = DateTime.Now - shift.StartTime;
                <div class="card" style="border-left:4px solid #4CAF50">
                    <div class="card-body" style="padding:20px">
                        <div class="d-flex align-items-center gap-3" style="margin-bottom:16px">
                            <div style="width:48px;height:48px;border-radius:50%;background:#4CAF5022;color:#4CAF50;display:flex;align-items:center;justify-content:center;font-size:20px">
                                <i class="fas fa-user-clock"></i>
                            </div>
                            <div>
                                <div style="font-weight:700;font-size:16px">
                                    @(string.IsNullOrEmpty(shift.User?.FullNameAr) ? (shift.User?.UserName ?? "Unknown") : shift.User!.FullNameAr)
                                </div>
                                <div style="font-size:12px;color:var(--text-muted)">
                                    Started: @shift.StartTime.ToString("hh:mm tt")
                                </div>
                            </div>
                            <span class="badge badge-success" style="margin-left:auto">Active</span>
                        </div>

                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px">
                            <div style="padding:10px;background:var(--bg-secondary);border-radius:8px;text-align:center">
                                <div style="font-size:18px;font-weight:700">@shift.TotalOrders</div>
                                <div style="font-size:11px;color:var(--text-muted)" data-t="orders">Orders</div>
                            </div>
                            <div style="padding:10px;background:var(--bg-secondary);border-radius:8px;text-align:center">
                                <div style="font-size:18px;font-weight:700">@shift.TotalSales.ToString("F2")</div>
                                <div style="font-size:11px;color:var(--text-muted)">EGP</div>
                            </div>
                        </div>

                        <div style="font-size:13px;color:var(--text-muted);margin-bottom:8px">
                            <i class="fas fa-clock me-2"></i>
                            Duration: @((int)duration.TotalHours)h @duration.Minutes m
                        </div>
                        <div style="font-size:13px;color:var(--text-muted)">
                            <i class="fas fa-money-bill me-2"></i>
                            Opening Cash: @shift.OpeningCash.ToString("F2") EGP
                        </div>
                        @if (shift.Branch != null)
                        {
                            <div style="margin-top:8px;font-size:12px;color:var(--text-muted)">
                                <i class="fas fa-code-branch me-2"></i>@shift.Branch.NameAr
                            </div>
                        }

                        <button class="btn btn-primary no-print" style="width:100%;margin-top:14px" onclick="openShiftReport(@shift.Id)">
                            🖨️ تقرير الوردية وتصفيرها
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title" data-t="shiftHistory">Shift History</h3>
        <span class="badge badge-primary">@closedShifts.Count</span>
    </div>
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th data-t="cashier">Cashier</th>
                    <th>Branch</th>
                    <th data-t="start">Start</th>
                    <th data-t="end">End</th>
                    <th data-t="duration">Duration</th>
                    <th data-t="orders">Orders</th>
                    <th data-t="totalSales">Total Sales</th>
                    <th data-t="openingCash">Opening</th>
                    <th data-t="closingCash">Closing</th>
                    <th data-t="difference">Diff</th>
                    <th class="no-print"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var shift in closedShifts.OrderByDescending(s => s.StartTime))
                {
                    var dur = (shift.EndTime ?? shift.StartTime) - shift.StartTime;
                    var diff = shift.ClosingCash - (shift.OpeningCash + shift.TotalSales);
                    <tr>
                        <td><strong>@(string.IsNullOrEmpty(shift.User?.FullNameAr) ? (shift.User?.UserName ?? "Unknown") : shift.User!.FullNameAr)</strong></td>
                        <td>
                            @if (shift.Branch != null)
                            {
                                <span style="font-size:12px">@shift.Branch.Icon @shift.Branch.Name</span>
                            }
                            else
                            {

                                <span style="color:var(--text-muted)">—</span>
                            }
                        </td>
                        <td>@shift.StartTime.ToString("MM/dd HH:mm")</td>
                        <td>@(shift.EndTime?.ToString("MM/dd HH:mm") ?? "—")</td>
                        <td>@((int)dur.TotalHours)h @dur.Minutes m</td>
                        <td>@shift.TotalOrders</td>
                        <td><strong>@shift.TotalSales.ToString("F2") EGP</strong></td>
                        <td>@shift.OpeningCash.ToString("F2")</td>
                        <td>@shift.ClosingCash.ToString("F2")</td>
                        <td style="color:@(diff >= 0 ? "var(--success)" : "var(--danger)");font-weight:600">
                            @(diff >= 0 ? "+" : "")@diff.ToString("F2")
                        </td>
                        <td class="no-print">
                            <button class="btn btn-sm btn-outline" onclick="openShiftReport(@shift.Id)">🖨️ التقرير</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ══════════ مودال تقرير الوردية ══════════ *@
<div class="modal-overlay" id="shiftReportModal">
    <div class="modal" style="max-width:520px">
        <div class="modal-header">
            <h3 class="modal-title" id="srmTitle">🧾 تقرير الوردية</h3>
            <button class="modal-close" onclick="Modal.close('shiftReportModal')">&times;</button>
        </div>
        <div class="modal-body">
            <div id="srmBody" style="font-size:13px">جارِ التحميل…</div>

            <div id="srmCloseSection" style="display:none;border-top:1px dashed var(--border);margin-top:16px;padding-top:16px">
                <div style="font-weight:800;font-size:13px;margin-bottom:8px">تصفير الوردية</div>
                <div class="form-group" style="margin:0 0 10px">
                    <label class="form-label">النقدية الفعلية في الدرج (بعد العد)</label>
                    <input type="number" step="0.01" id="srmClosingCash" class="form-control" placeholder="0.00">
                    <div id="srmDiffPreview" style="font-size:11px;margin-top:4px;font-weight:700"></div>
                </div>
                <div class="form-group" style="margin:0">
                    <label class="form-label">ملاحظات (اختياري)</label>
                    <textarea id="srmNotes" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="printShiftReport()">🖨️ طباعة</button>
            <button class="btn btn-accent" id="srmCloseBtn" style="display:none" onclick="confirmCloseShift()">✅ تأكيد وتصفير الوردية</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const SHIFT_SETTINGS = @Html.Raw(settingsJson);
        let currentShiftReport = null;

        async function openShiftReport(shiftId) {
            document.getElementById('srmBody').innerHTML = 'جارِ التحميل…';
            document.getElementById('srmCloseSection').style.display = 'none';
            document.getElementById('srmCloseBtn').style.display = 'none';
            document.getElementById('srmClosingCash').value = '';
            document.getElementById('srmNotes').value = '';
            Modal.open('shiftReportModal');

            try {
                const d = await API.get('/Admin/GetShiftReport?shiftId=' + shiftId + '&t=' + Date.now());
                if (!d.success) { Toast.error(d.message || 'تعذر تحميل تقرير الوردية'); Modal.close('shiftReportModal'); return; }

                currentShiftReport = d;
                document.getElementById('srmTitle').textContent = '🧾 تقرير وردية — ' + d.cashier;
                document.getElementById('srmBody').innerHTML = renderShiftReportHtml(d, false);

                if (!d.isClosed) {
                    document.getElementById('srmCloseSection').style.display = 'block';
                    document.getElementById('srmCloseBtn').style.display = 'inline-flex';
                    document.getElementById('srmClosingCash').value = d.expectedCash.toFixed(2);
                    updateDiffPreview();
                    document.getElementById('srmClosingCash').oninput = updateDiffPreview;
                }
            } catch (e) {
                document.getElementById('srmBody').innerHTML = 'تعذر تحميل التقرير';
            }
        }

        function updateDiffPreview() {
            if (!currentShiftReport) return;
            const entered = parseFloat(document.getElementById('srmClosingCash').value) || 0;
            const diff = entered - currentShiftReport.expectedCash;
            const el = document.getElementById('srmDiffPreview');
            if (Math.abs(diff) < 0.01) { el.textContent = '✅ مطابق تمامًا للمتوقع'; el.style.color = '#16A34A'; }
            else if (diff > 0) { el.textContent = `زيادة ${diff.toFixed(2)} ج.م عن المتوقع`; el.style.color = '#F59E0B'; }
            else { el.textContent = `عجز ${Math.abs(diff).toFixed(2)} ج.م عن المتوقع`; el.style.color = '#EF4444'; }
        }

        /* بناء نفس محتوى التقرير — يُستخدم في المعاينة داخل المودال وفي الطباعة الحرارية */
        function renderShiftReportHtml(d, forPrint) {
            const orgName   = SHIFT_SETTINGS['OrgName']   || 'نادي دار الطائرات';
            const orgNameEn = SHIFT_SETTINGS['OrgNameEn'] || 'Aircraft Factory Club';
            const phone     = SHIFT_SETTINGS['Phone']     || '';

            const payAr = { Cash: 'كاش', Card: 'بطاقة', Wallet: 'محفظة', Mixed: 'مختلط' };

            const fmtDT = iso => {
                const dt = new Date(iso.endsWith('Z') ? iso : iso + 'Z');
                return dt.toLocaleString('ar-EG', { dateStyle: 'short', timeStyle: 'short' });
            };

            const header = forPrint ? `
                <div class="inv-center">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px">
                        <img src="/logo.jpg" style="max-width:60px;max-height:60px;object-fit:contain" onerror="this.style.display='none'">
                        <img src="/qrcode.jpeg" style="width:55px;height:55px;object-fit:contain" onerror="this.style.display='none'">
                    </div>
                    <div class="inv-org">${orgName}</div>
                    <div class="inv-sub">${orgNameEn}</div>
                    ${phone ? `<div class="inv-sub">Tel: ${phone}</div>` : ''}
                </div>
                <hr>
                <div class="inv-center" style="font-size:15px;font-weight:800;margin-bottom:4px">تقرير تصفير وردية</div>
                <hr>` : '';

            const paymentRows = (d.paymentBreakdown || []).map(p => `
                <div class="inv-row"><span>${payAr[p.method] || p.method} (${p.count})</span><span>${Number(p.total).toFixed(2)}</span></div>`).join('');

            const productRows = (d.topProducts || []).map(p => `
                <div class="inv-row"><span>${p.productName} × ${p.quantity}</span><span>${Number(p.total).toFixed(2)}</span></div>`).join('');

            const refundRows = (d.refunds || []).map(r => `
                <div class="inv-row"><span>${r.refundNumber} (${r.time}) — طلب ${r.originalOrder}</span><span style="color:#c00">-${Number(r.amount).toFixed(2)}</span></div>
                ${r.reason && r.reason !== '—' ? `<div style="font-size:10px;color:#666;margin-bottom:4px">السبب: ${r.reason}</div>` : ''}`).join('');

            return `
                ${header}
                <div class="inv-row"><span>الكاشير:</span><span class="inv-bold">${d.cashier}</span></div>
                <div class="inv-row"><span>الفرع:</span><span>${d.branch}</span></div>
                <div class="inv-row"><span>بداية الوردية:</span><span>${fmtDT(d.startTime)}</span></div>
                <div class="inv-row"><span>${d.isClosed ? 'نهاية الوردية:' : 'الوقت الحالي:'}</span><span>${fmtDT(d.endTime || new Date().toISOString())}</span></div>
                <hr>
                <div class="inv-row"><span>عدد الطلبات:</span><span class="inv-bold">${d.ordersCount}</span></div>
                <div class="inv-row"><span>عدد الأصناف المباعة:</span><span>${d.itemsSoldCount}</span></div>
                ${d.cancelledCount > 0 ? `<div class="inv-row"><span>طلبات ملغاة:</span><span>${d.cancelledCount}</span></div>` : ''}
                <hr>
                <div style="font-weight:800;margin-bottom:4px">طرق الدفع</div>
                ${paymentRows || '<div class="inv-row"><span>لا توجد مبيعات</span><span></span></div>'}
                <hr>
                <div style="font-weight:800;margin-bottom:4px">الأصناف المباعة</div>
                ${productRows || '<div class="inv-row"><span>—</span><span></span></div>'}
                <hr>
                <div style="font-weight:800;margin-bottom:4px;${d.hasRefunds ? 'color:#c00' : ''}">
                    ${d.hasRefunds ? `⚠️ مرتجعات (${d.refunds.length})` : '✅ لا يوجد مرتجعات'}
                </div>
                ${d.hasRefunds ? refundRows : ''}
                <hr>
                <div class="inv-row"><span>إجمالي المبيعات:</span><span class="inv-bold">${Number(d.grossSales).toFixed(2)} ج.م</span></div>
                ${d.refundTotal > 0 ? `<div class="inv-row" style="color:#c00"><span>إجمالي المرتجعات:</span><span>-${Number(d.refundTotal).toFixed(2)} ج.م</span></div>` : ''}
                <div class="inv-row inv-total"><span>صافي المبيعات:</span><span>${Number(d.netSales).toFixed(2)} ج.م</span></div>
                <hr>
                <div class="inv-row"><span>عهدة أول الوردية:</span><span>${Number(d.openingCash).toFixed(2)}</span></div>
                <div class="inv-row"><span>المتوقع بالدرج (كاش):</span><span class="inv-bold">${Number(d.expectedCash).toFixed(2)}</span></div>
                ${d.isClosed ? `
                <div class="inv-row"><span>الفعلي بالدرج:</span><span>${Number(d.closingCash).toFixed(2)}</span></div>
                <div class="inv-row inv-bold"><span>الفرق:</span><span>${(d.closingCash - d.expectedCash).toFixed(2)}</span></div>` : ''}
                ${forPrint ? `<div class="inv-footer">تم الطبع ${new Date().toLocaleString('ar-EG')}</div>` : ''}
            `;
        }

        function printShiftReport() {
            if (!currentShiftReport) return;
            printInvoice(renderShiftReportHtml(currentShiftReport, true));
        }

        async function confirmCloseShift() {
            if (!currentShiftReport) return;
            const closingCash = parseFloat(document.getElementById('srmClosingCash').value);
            if (isNaN(closingCash) || closingCash < 0) { Toast.error('أدخل قيمة النقدية الفعلية'); return; }

            if (!confirm('تأكيد تصفير هذه الوردية؟ الإجراء ده نهائي ومش هترجع الوردية تفتح تاني.')) return;

            Loading.show();
            try {
                const r = await API.post('/Admin/ForceCloseShift', {
                    shiftId: currentShiftReport.shiftId,
                    closingCash: closingCash,
                    notes: document.getElementById('srmNotes').value || null
                });
                if (r.success) {
                    Toast.success('تم تصفير الوردية بنجاح');
                    Modal.close('shiftReportModal');
                    setTimeout(() => location.reload(), 800);
                } else {
                    Toast.error(r.message || 'تعذر تصفير الوردية');
                }
            } finally { Loading.hide(); }
        }
    </script>
}
